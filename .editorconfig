root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
tab_width = 2

[*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,yaml,yml,css,md}]
indent_style = space
indent_size = 2
tab_width = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
indent_size = tab

[*.mk]
indent_style = tab
indent_size = tab

[package-lock.json]
trim_trailing_whitespace = false
