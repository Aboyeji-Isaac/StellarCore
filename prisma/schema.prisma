// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AnchorStatus {
  LIVE
  DEGRADED
  DOWN
  UNKNOWN

  @@map("anchor_status")
}

enum TransferStatus {
  COMPLETED
  PARTIAL
  REFUNDED
  EXPIRED
  ERROR

  @@map("transfer_status")
}

enum ReputationScoreBand {
  GREEN @map("green")
  AMBER @map("amber")
  RED   @map("red")

  @@map("reputation_score_band")
}

enum ReputationState {
  INSUFFICIENT_DATA @map("insufficient_data")
  OK                @map("ok")

  @@map("reputation_state")
}

/// Reviewed lifecycle state of a persisted anchor. Retirement removes an
/// anchor from reviewed configuration; it is not an observation of external
/// downtime or anchor health.
enum RegistryLifecycleState {
  ACTIVE
  RETIRED

  @@map("registry_lifecycle_state")
}

/// Truthful origin of an operator action: a system process (no identity) or a
/// verified human operator identity supplied by a trusted boundary.
enum OperatorActorType {
  SYSTEM
  HUMAN

  @@map("operator_actor_type")
}

/// A ledger row always describes an applied action. Dry runs are previewed and
/// are never persisted as applied records.
enum OperatorActionMode {
  DRY_RUN
  APPLIED

  @@map("operator_action_mode")
}

enum OperatorTargetType {
  RATE_SNAPSHOT
  ANCHOR

  @@map("operator_target_type")
}

/// Stable vocabulary of supported privileged administrative actions.
enum OperatorActionType {
  RATE_SNAPSHOT_INVALIDATED
  RATE_SNAPSHOT_SUPERSEDED
  RATE_DISPOSITION_RECOVERED
  ANCHOR_RETIRED
  ANCHOR_REACTIVATED

  @@map("operator_action_type")
}

/// Stable vocabulary of reviewed reasons for a privileged action.
enum OperatorReasonCode {
  SOURCE_ERROR
  DUPLICATE_OBSERVATION
  STALE_ARTIFACT
  DATA_CORRECTION
  REVIEWED_CONFIGURATION_REMOVAL
  OPERATOR_RECOVERY
  OTHER_REVIEWED

  @@map("operator_reason_code")
}

enum RateSnapshotDispositionType {
  INVALIDATED
  SUPERSEDED

  @@map("rate_snapshot_disposition_type")
}

model Anchor {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String                 @unique
  name              String
  homeDomain        String                 @map("home_domain")
  tomlUrl           String                 @map("toml_url")
  seps              Int[]                  @default([])
  isTransferCapable Boolean                @default(false) @map("is_transfer_capable")
  status            AnchorStatus           @default(UNKNOWN)
  lifecycleState    RegistryLifecycleState @default(ACTIVE) @map("lifecycle_state")
  retiredAt         DateTime?              @map("retired_at") @db.Timestamptz(6)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  corridors        AnchorCorridor[]
  rateSnapshots    RateSnapshot[]
  transferOutcomes TransferOutcome[]
  reputationScore  ReputationScore?

  @@map("anchors")
}

model Corridor {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetCodeFrom String @map("asset_code_from")
  countryFrom   String @map("country_from")
  assetCodeTo   String @map("asset_code_to")
  countryTo     String @map("country_to")
  slug          String @unique

  anchors          AnchorCorridor[]
  rateSnapshots    RateSnapshot[]
  transferOutcomes TransferOutcome[]

  @@map("corridors")
}

model AnchorCorridor {
  anchorId   String @map("anchor_id") @db.Uuid
  corridorId String @map("corridor_id") @db.Uuid

  anchor   Anchor   @relation(fields: [anchorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  corridor Corridor @relation(fields: [corridorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([anchorId, corridorId])
  @@index([corridorId], map: "anchor_corridors_corridor_id_idx")
  @@map("anchor_corridors")
}

/// One individual anchor quote for a corridor. Freshness is derived from
/// capturedAt at read time; computed corridor medians are not stored here.
model RateSnapshot {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  anchorId          String   @map("anchor_id") @db.Uuid
  corridorId        String   @map("corridor_id") @db.Uuid
  rate              Decimal  @db.Decimal(38, 18)
  sourceAmount      Decimal  @map("source_amount") @db.Decimal(38, 18)
  destinationAmount Decimal  @map("destination_amount") @db.Decimal(38, 18)
  fee               Decimal  @default(0) @db.Decimal(38, 18)
  capturedAt        DateTime @default(now()) @map("captured_at") @db.Timestamptz(6)

  anchor      Anchor                   @relation(fields: [anchorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  corridor    Corridor                 @relation(fields: [corridorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  disposition RateSnapshotDisposition?

  @@index([corridorId, capturedAt(sort: Desc)], map: "rate_snapshots_corridor_id_captured_at_idx")
  @@index([anchorId, capturedAt(sort: Desc)], map: "rate_snapshots_anchor_id_captured_at_idx")
  /// Covering index for findLatestObservations
  /// (lib/rates/latestRateRepository.ts), the per-corridor
  /// DISTINCT ON (anchor_id) ... ORDER BY anchor_id, captured_at DESC,
  /// id DESC behind GET /api/rates. The payload columns are index keys only
  /// because Prisma cannot express INCLUDE; after the unique id they never
  /// affect ordering. With every selected column in the index, Postgres
  /// answers the query with an ordered index-only scan — no heap visits and
  /// no sort of the corridor's whole snapshot history.
  @@index([corridorId, anchorId, capturedAt(sort: Desc), id(sort: Desc), rate, sourceAmount, destinationAmount, fee], map: "rate_snapshots_latest_observation_idx")
  /// Serves the reputation evidence read (lib/reputation/repository.ts), the
  /// per-anchor DISTINCT ON (corridor.slug) latest-quote scan: an index-only
  /// scan replaces the bitmap heap scan over the anchor's whole history.
  @@index([anchorId, corridorId, capturedAt(sort: Desc), id(sort: Desc)], map: "rate_snapshots_anchor_corridor_latest_idx")
  @@map("rate_snapshots")
}

model TransferOutcome {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  anchorId     String         @map("anchor_id") @db.Uuid
  corridorId   String         @map("corridor_id") @db.Uuid
  status       TransferStatus
  fillRate     Float          @map("fill_rate")
  settlementMs Int            @map("settlement_ms")
  slippage     Float
  recordedAt   DateTime       @default(now()) @map("recorded_at") @db.Timestamptz(6)

  anchor   Anchor   @relation(fields: [anchorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  corridor Corridor @relation(fields: [corridorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([anchorId, recordedAt(sort: Desc)], map: "transfer_outcomes_anchor_id_recorded_at_idx")
  @@map("transfer_outcomes")
}

model ReputationScore {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  anchorId       String               @unique @map("anchor_id") @db.Uuid
  compositeScore Float?               @map("composite_score")
  scoreBand      ReputationScoreBand? @map("score_band")
  fillRate7d     Float?               @map("fill_rate_7d")
  fillRate30d    Float?               @map("fill_rate_30d")
  fillRate90d    Float?               @map("fill_rate_90d")
  settleP50Ms    Int?                 @map("settle_p50_ms")
  settleP95Ms    Int?                 @map("settle_p95_ms")
  slippageP50    Float?               @map("slippage_p50")
  slippageP95    Float?               @map("slippage_p95")
  sampleSize     Int                  @default(0) @map("sample_size")
  state          ReputationState      @default(INSUFFICIENT_DATA)
  computedAt     DateTime             @default(now()) @map("computed_at") @db.Timestamptz(6)

  anchor Anchor @relation(fields: [anchorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("reputation_scores")
}

/// Append-only ledger of privileged administrative actions that change evidence
/// usability or reviewed lifecycle state. Rows are immutable at the database
/// level (see the append-only trigger in the migration) and are written in the
/// same transaction as the state change they describe. This records StellarCore
/// governance and is never evidence about an anchor's behavior.
model OperatorAction {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actionId    String             @unique @map("action_id")
  actionType  OperatorActionType @map("action_type")
  mode        OperatorActionMode @default(APPLIED)
  targetType  OperatorTargetType @map("target_type")
  targetId    String             @map("target_id")
  targetLabel String?            @map("target_label")
  reasonCode  OperatorReasonCode @map("reason_code")
  rationale   String?
  actorType   OperatorActorType  @map("actor_type")
  actorId     String?            @map("actor_id")
  runId       String?            @map("run_id")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  rateSnapshotDispositions RateSnapshotDisposition[]

  @@index([targetType, targetId, createdAt(sort: Desc)], map: "operator_actions_target_idx")
  @@index([runId], map: "operator_actions_run_id_idx")
  @@index([actionType, createdAt(sort: Desc)], map: "operator_actions_action_type_idx")
  @@index([actorType, createdAt(sort: Desc)], map: "operator_actions_actor_type_idx")
  @@map("operator_actions")
}

/// Current administrative disposition for a persisted rate snapshot. It never
/// rewrites the immutable historical RateSnapshot row; it only makes that
/// snapshot ineligible for the latest-rate read model until recovered.
model RateSnapshotDisposition {
  id             String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  snapshotId     String                      @unique @map("snapshot_id") @db.Uuid
  disposition    RateSnapshotDispositionType
  reasonCode     OperatorReasonCode          @map("reason_code")
  rationale      String?
  actorType      OperatorActorType           @map("actor_type")
  actorId        String?                     @map("actor_id")
  runId          String?                     @map("run_id")
  actionRecordId String                      @map("action_record_id") @db.Uuid
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)

  snapshot     RateSnapshot   @relation(fields: [snapshotId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actionRecord OperatorAction @relation(fields: [actionRecordId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([disposition], map: "rate_snapshot_dispositions_type_idx")
  @@map("rate_snapshot_dispositions")
}
