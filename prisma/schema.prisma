// SEP-1 Discovery Observation Model
model SEP1DiscoveryObservation {
  id            String   @id @default(uuid())
  anchorId      String   @unique
  observedAt    DateTime
  metadata      Json      // Canonicalized TOML fields
  digest        String   // SHA-256 of canonicalized metadata
  parserState   String   // Success/error state
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Approved Baseline Record
model SEP1ApprovedBaseline {
  id            String   @id @default(uuid())
  anchorId      String   @unique
  observationId String   @unique
  approvedFields Json      // Subset of sensitive fields
  approvedAt    DateTime
  approvedBy    String   // Operator reference
  reason        String   // Approval/rejection rationale
  createdAt     DateTime @default(now())
}

// Migration for existing anchors
model SEP1MigrationStatus {
  anchorId      String   @unique
  baselineApproved Boolean  @default(false)
  migrationComplete Boolean @default(false)
}