// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AnchorStatus {
  LIVE
  DEGRADED
  DOWN
  UNKNOWN

  @@map("anchor_status")
}

enum Sep1ObservationAssessment {
  NO_BASELINE
  MATCHES_BASELINE
  CHANGED_UNREVIEWED

  @@map("sep1_observation_assessment")
}

enum Sep1ReviewDecision {
  APPROVED
  REJECTED

  @@map("sep1_review_decision")
}

enum TransferStatus {
  COMPLETED
  PARTIAL
  REFUNDED
  EXPIRED
  ERROR

  @@map("transfer_status")
}

enum ReputationScoreBand {
  GREEN @map("green")
  AMBER @map("amber")
  RED   @map("red")

  @@map("reputation_score_band")
}

enum ReputationState {
  INSUFFICIENT_DATA @map("insufficient_data")
  OK                @map("ok")

  @@map("reputation_state")
}

model Anchor {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String       @unique
  name              String
  homeDomain        String       @map("home_domain")
  tomlUrl           String       @map("toml_url")
  seps              Int[]        @default([])
  isTransferCapable Boolean      @default(false) @map("is_transfer_capable")
  status            AnchorStatus @default(UNKNOWN)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  corridors        AnchorCorridor[]
  rateSnapshots    RateSnapshot[]
  transferOutcomes TransferOutcome[]
  reputationScore  ReputationScore?
  sep1Observations Sep1DiscoveryObservation[]
  sep1Reviews      Sep1MetadataReview[]

  @@map("anchors")
}

model Corridor {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetCodeFrom String @map("asset_code_from")
  countryFrom   String @map("country_from")
  assetCodeTo   String @map("asset_code_to")
  countryTo     String @map("country_to")
  slug          String @unique

  anchors          AnchorCorridor[]
  rateSnapshots    RateSnapshot[]
  transferOutcomes TransferOutcome[]

  @@map("corridors")
}

model AnchorCorridor {
  anchorId   String @map("anchor_id") @db.Uuid
  corridorId String @map("corridor_id") @db.Uuid

  anchor   Anchor   @relation(fields: [anchorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  corridor Corridor @relation(fields: [corridorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([anchorId, corridorId])
  @@index([corridorId], map: "anchor_corridors_corridor_id_idx")
  @@map("anchor_corridors")
}

/// One individual anchor quote for a corridor. Freshness is derived from
/// capturedAt at read time; computed corridor medians are not stored here.
model RateSnapshot {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  anchorId          String   @map("anchor_id") @db.Uuid
  corridorId        String   @map("corridor_id") @db.Uuid
  rate              Decimal  @db.Decimal(38, 18)
  sourceAmount      Decimal  @map("source_amount") @db.Decimal(38, 18)
  destinationAmount Decimal  @map("destination_amount") @db.Decimal(38, 18)
  fee               Decimal  @default(0) @db.Decimal(38, 18)
  capturedAt        DateTime @default(now()) @map("captured_at") @db.Timestamptz(6)

  anchor   Anchor   @relation(fields: [anchorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  corridor Corridor @relation(fields: [corridorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([corridorId, capturedAt(sort: Desc)], map: "rate_snapshots_corridor_id_captured_at_idx")
  @@index([anchorId, capturedAt(sort: Desc)], map: "rate_snapshots_anchor_id_captured_at_idx")
  /// Covering index for findLatestObservations
  /// (lib/rates/latestRateRepository.ts), the per-corridor
  /// DISTINCT ON (anchor_id) ... ORDER BY anchor_id, captured_at DESC,
  /// id DESC behind GET /api/rates. The payload columns are index keys only
  /// because Prisma cannot express INCLUDE; after the unique id they never
  /// affect ordering. With every selected column in the index, Postgres
  /// answers the query with an ordered index-only scan — no heap visits and
  /// no sort of the corridor's whole snapshot history.
  @@index([corridorId, anchorId, capturedAt(sort: Desc), id(sort: Desc), rate, sourceAmount, destinationAmount, fee], map: "rate_snapshots_latest_observation_idx")
  /// Serves the reputation evidence read (lib/reputation/repository.ts), the
  /// per-anchor DISTINCT ON (corridor.slug) latest-quote scan: an index-only
  /// scan replaces the bitmap heap scan over the anchor's whole history.
  @@index([anchorId, corridorId, capturedAt(sort: Desc), id(sort: Desc)], map: "rate_snapshots_anchor_corridor_latest_idx")
  @@map("rate_snapshots")
}

model TransferOutcome {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  anchorId     String         @map("anchor_id") @db.Uuid
  corridorId   String         @map("corridor_id") @db.Uuid
  status       TransferStatus
  fillRate     Float          @map("fill_rate")
  settlementMs Int            @map("settlement_ms")
  slippage     Float
  recordedAt   DateTime       @default(now()) @map("recorded_at") @db.Timestamptz(6)

  anchor   Anchor   @relation(fields: [anchorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  corridor Corridor @relation(fields: [corridorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([anchorId, recordedAt(sort: Desc)], map: "transfer_outcomes_anchor_id_recorded_at_idx")
  @@map("transfer_outcomes")
}

model ReputationScore {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  anchorId       String               @unique @map("anchor_id") @db.Uuid
  compositeScore Float?               @map("composite_score")
  scoreBand      ReputationScoreBand? @map("score_band")
  fillRate7d     Float?               @map("fill_rate_7d")
  fillRate30d    Float?               @map("fill_rate_30d")
  fillRate90d    Float?               @map("fill_rate_90d")
  settleP50Ms    Int?                 @map("settle_p50_ms")
  settleP95Ms    Int?                 @map("settle_p95_ms")
  slippageP50    Float?               @map("slippage_p50")
  slippageP95    Float?               @map("slippage_p95")
  sampleSize     Int                  @default(0) @map("sample_size")
  state          ReputationState      @default(INSUFFICIENT_DATA)
  computedAt     DateTime             @default(now()) @map("computed_at") @db.Timestamptz(6)

  anchor Anchor @relation(fields: [anchorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("reputation_scores")
}

/// Append-only record of one successful SEP-1 discovery (fetch + parse). It is
/// an anchor-controlled assertion, not proof that an advertised capability
/// works. `metadata` is canonical, sanitized JSON (no raw TOML, no URL
/// userinfo/fragments, hashed query values); `digest` and `sensitiveDigest`
/// are versioned SHA-256 hashes (see lib/stellar/sep1History.ts). Fetch or
/// parse failures are never stored here. UPDATE/DELETE are rejected by a
/// database trigger. `assessment`/`diff` record the comparison against the
/// approved baseline that was in force when the observation was made.
model Sep1DiscoveryObservation {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  anchorId          String                    @map("anchor_id") @db.Uuid
  canonicalVersion  Int                       @map("canonical_version")
  digest            String                    @db.Char(64)
  sensitiveDigest   String                    @map("sensitive_digest") @db.Char(64)
  tomlUrl           String                    @map("toml_url")
  metadata          Json
  assessment        Sep1ObservationAssessment
  diff              Json
  baselineReviewId  String?                   @map("baseline_review_id") @db.Uuid
  fetchedAt         DateTime                  @default(now()) @map("fetched_at") @db.Timestamptz(6)

  anchor         Anchor              @relation(fields: [anchorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  baselineReview Sep1MetadataReview? @relation("BaselineReview", fields: [baselineReviewId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviews        Sep1MetadataReview[] @relation("ReviewedObservation")

  @@index([anchorId, fetchedAt(sort: Desc)], map: "sep1_discovery_observations_anchor_fetched_idx")
  @@index([anchorId, digest], map: "sep1_discovery_observations_anchor_digest_idx")
  @@map("sep1_discovery_observations")
}

/// Append-only operator decision on one specific observation digest. The
/// approved baseline for an anchor is the sensitive metadata of the newest
/// APPROVED review's observation; anchors with no APPROVED review have no
/// baseline (legacy anchors are never back-filled from today's TOML). Approval
/// means maintainers reviewed that observed metadata, not that the anchor is
/// reachable or its quotes are correct.
model Sep1MetadataReview {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  anchorId          String             @map("anchor_id") @db.Uuid
  observationId     String             @map("observation_id") @db.Uuid
  observationDigest String             @map("observation_digest") @db.Char(64)
  sensitiveDigest   String             @map("sensitive_digest") @db.Char(64)
  decision          Sep1ReviewDecision
  actor             String
  reference         String
  reason            String
  reviewedFields    String[]           @default([]) @map("reviewed_fields")
  reviewedAt        DateTime           @default(now()) @map("reviewed_at") @db.Timestamptz(6)

  anchor      Anchor                     @relation(fields: [anchorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  observation Sep1DiscoveryObservation   @relation("ReviewedObservation", fields: [observationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  baselineFor Sep1DiscoveryObservation[] @relation("BaselineReview")

  @@index([anchorId, decision, reviewedAt(sort: Desc)], map: "sep1_metadata_reviews_anchor_decision_reviewed_idx")
  @@map("sep1_metadata_reviews")
}
