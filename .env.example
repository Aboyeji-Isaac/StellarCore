# Required outside tests. Server-only application and Prisma CLI connection.
# Must use postgres:// or postgresql://.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Optional writable directory for bounded last-known-good public evidence.
# Defaults to a per-instance directory in the Node.js temporary directory.
# STALE_EVIDENCE_DIRECTORY="/path/to/writable/stale-evidence"

# Required in production when Vercel Cron is enabled; never expose to the client.
CRON_SECRET="replace-with-a-random-server-only-secret"

# Explicit runtime environment identity (#143). One of: production, preview,
# development, test, ci. The runtime refuses database access when this does not
# match the database's durable environment stamp (table database_environment).
# On Vercel, VERCEL_ENV is used automatically when this variable is absent.
STELLARCORE_ENVIRONMENT="development"

# Stamp target for `npm run stamp:environment` (operator tooling only; run it
# from the protected migration workflow, never from an application runtime).
# STELLARCORE_STAMP_ENVIRONMENT="production"

# Optional rate freshness threshold in milliseconds. Default: 120000.
# RATE_FRESHNESS_THRESHOLD_MS="120000"

# Optional minimum fresh independent sources required for a median. Default: 2.
# MIN_FRESH_SOURCES="2"

# Release/runtime configuration fingerprint (#214). Production should set this
# to the SHA-256 fingerprint recorded in the reviewed release provenance.
# STELLARCORE_CONFIG_FINGERPRINT="64-hex-character-fingerprint"

# Drift policy: fail, degrade, or warn. Production defaults to fail; non-production
# defaults to warn when omitted.
# STELLARCORE_CONFIG_DRIFT_POLICY="fail"

# Optional explicit deployment revision. VERCEL_GIT_COMMIT_SHA or GITHUB_SHA is
# used when available; release provenance binds the fingerprint to the commit SHA.
# STELLARCORE_DEPLOYMENT_REVISION="git-commit-sha"
