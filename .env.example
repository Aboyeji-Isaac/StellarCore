# StellarCore environment template.
#
# Copy this file to `.env.local` (local development) or `.env` (scripts that
# load dotenv) and fill in real values. Keep real secrets out of the repo:
# `.env*` files are git-ignored; only this example file is committed.

# --------------------------------------------------------------------
# Application runtime
# --------------------------------------------------------------------

# Server-only PostgreSQL connection URL for the app and all Prisma tooling.
# Must use postgres:// or postgresql:// (never prisma:// or prisma+postgres://).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Server-only Bearer secret required by /api/internal/cron/refresh when Vercel
# Cron is enabled. Generate with: openssl rand -hex 32
CRON_SECRET="replace-with-a-random-server-only-secret"

# --------------------------------------------------------------------
# Opt-in integration tests (never set in production; all default to off)
# --------------------------------------------------------------------

# Set to 1 to run the anchors API database integration test.
RUN_DATABASE_INTEGRATION=""

# Set to 1 to run the reputation engine database integration test.
RUN_REPUTATION_DATABASE_INTEGRATION=""

# Set to 1 to run the reputation API database integration test.
RUN_REPUTATION_API_DATABASE_INTEGRATION=""
