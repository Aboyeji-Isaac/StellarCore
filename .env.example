# Required application and Prisma CLI connection. Use a direct PostgreSQL URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Optional per-role runtime connections. When unset, both roles use DATABASE_URL.
# DATABASE_READ_URL="postgresql://READER:PASSWORD@HOST:PORT/DATABASE"
# DATABASE_WRITE_URL="postgresql://WRITER:PASSWORD@HOST:PORT/DATABASE"

# Optional runtime database resource budget. Every value is a finite integer;
# zero, negatives, and unlimited tokens are rejected. Profile-specific variables
# (DB_READ_*, DB_WRITE_*) override the DB_* globals. See
# docs/database-resource-budget.md for units, ranges, defaults, and sizing.
# DB_APPLICATION_NAME="stellarcore"
# DB_POOL_MAX="4"
# DB_CONNECTION_TIMEOUT_MS="2000"
# DB_POOL_IDLE_TIMEOUT_MS="30000"
# DB_POOL_MAX_LIFETIME_SECONDS="1800"
# DB_STATEMENT_TIMEOUT_MS="3000"
# DB_LOCK_TIMEOUT_MS="1000"
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS="5000"
# DB_INTERACTIVE_TRANSACTION_TIMEOUT_MS="3000"
# DB_INTERACTIVE_TRANSACTION_MAX_WAIT_MS="1000"

# Required in production when Vercel Cron is enabled; never expose to the client.
CRON_SECRET="replace-with-a-random-server-only-secret"
