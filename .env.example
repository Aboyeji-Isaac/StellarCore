# Server-only PostgreSQL connections. Use direct postgres:// or postgresql://
# URLs. Each credential belongs to a different PostgreSQL role; see
# docs/DEPLOYMENT.md#database-roles. There is no fallback between them.

# Public read-only role (SELECT only): public API routes and the dashboard.
DATABASE_READ_URL="postgresql://READ_USER:PASSWORD@HOST:PORT/DATABASE"

# Internal writer role (reviewed DML, no DDL): scheduled refresh, registry
# bootstrap, rate and reputation persistence.
DATABASE_WRITE_URL="postgresql://WRITE_USER:PASSWORD@HOST:PORT/DATABASE"

# Migration owner (owns schema objects). Read only by the Prisma CLI and
# `npm run db:grants`. Local development only: never configure it for a
# deployed runtime, which refuses to start when it is present in production.
MIGRATION_DATABASE_URL="postgresql://OWNER_USER:PASSWORD@HOST:PORT/DATABASE"

# Optional runtime role names for `npm run db:grants` (defaults shown).
# DATABASE_READ_ROLE="stellarcore_reader"
# DATABASE_WRITE_ROLE="stellarcore_writer"

# Required in production when Vercel Cron is enabled; never expose to the client.
CRON_SECRET="replace-with-a-random-server-only-secret"
