# Required application and Prisma CLI connection. Use a direct PostgreSQL URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Required in production when Vercel Cron is enabled; never expose to the client.
CRON_SECRET="replace-with-a-random-server-only-secret"

# Expected deployment-time runtime configuration fingerprint (sha256 hex of the canonicalized non-secret config shape + policy identifiers + revision).
# Emitted during build/release and recomputed at runtime/startup. Mismatch behavior is controlled by RUNTIME_CONFIG_DRIFT_POLICY.
# Secret values are never included; only presence/version metadata is considered.
RUNTIME_CONFIG_FINGERPRINT=""

# Policy for runtime fingerprint mismatch: "strict" (fail startup), "degrade" (start with degraded operations + alert), or "off" (log only). Defaults to "strict" in production.
RUNTIME_CONFIG_DRIFT_POLICY="strict"
